# ============================================================================
# TramitAI - produção. Não edite os valores __GERAR__: rode `python3 infra/init_env.py`,
# que cria o .env com segredos novos. Depois preencha só o que está marcado PREENCHER.
# ============================================================================

# --- Endereço (PREENCHER) ---
DOMAIN=app.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br
DJANGO_ALLOWED_HOSTS=app.seudominio.com.br,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.seudominio.com.br

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=__GERAR__
DJANGO_DEBUG=False

# --- Postgres (superusuário só para init e backup) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GERAR__
POSTGRES_DB=postgres
TRAMITAI_DB_NAME=tramitai
TRAMITAI_OWNER_PASSWORD=__GERAR__
TRAMITAI_APP_PASSWORD=__GERAR__
DATABASE_URL=__GERAR__
DATABASE_OWNER_URL=__GERAR__
DB_APP_ROLE=tramitai_app

REDIS_URL=redis://redis:6379/0

# --- Segredos de campo (tokens) e ponte do WhatsApp ---
FIELD_ENCRYPTION_KEYS=__GERAR__
WHATSAPP_BRIDGE_URL=http://bridge:3100
WHATSAPP_BRIDGE_SECRET=__GERAR__
# Cloud API da Meta (só se algum escritório usar a API oficial)
WHATSAPP_GATEWAY=cloud_api
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=__GERAR__

# --- IA (PREENCHER) ---
# fake | anthropic | gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Mercado Pago ---
# Cada escritório conecta a própria conta pela tela (Configurações → Mercado Pago).
MERCADOPAGO_CLIENT=http

# --- Andamentos (PREENCHER a chave da wiki do CNJ) ---
PROCESS_SOURCE=datajud
DATAJUD_API_KEY=

# --- E-mail (PREENCHER: "esqueci minha senha" e alertas) ---
# Ex. Brevo: smtp+tls://USUARIO:SENHA@smtp-relay.brevo.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=TramitAI <nao-responda@seudominio.com.br>

# --- Backup ---
# GUARDE ESTA FRASE FORA DO SERVIDOR: sem ela o backup não abre.
BACKUP_PASSPHRASE=__GERAR__
BACKUP_HOUR=6
BACKUP_KEEP_DAYS=14
# Cópia fora do servidor (opcional, recomendado). Ex. Cloudflare R2:
# BACKUP_RCLONE_REMOTE=r2:tramitai-backups
# RCLONE_CONFIG_R2_TYPE=s3
# RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
BACKUP_RCLONE_REMOTE=

LOG_LEVEL=INFO
