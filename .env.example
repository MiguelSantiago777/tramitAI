# Copie para .env e ajuste. Nunca commite o .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Postgres ---
# Superusuário do container (só usado pelo script de init para criar os roles).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local
POSTGRES_DB=postgres
# Dono das tabelas: roda migrations. Nunca usado pela aplicação em runtime.
TRAMITAI_DB_NAME=tramitai
TRAMITAI_OWNER_PASSWORD=owner-local
# Role da aplicação: só DML, sem superuser e sem BYPASSRLS.
TRAMITAI_APP_PASSWORD=app-local

DATABASE_URL=postgres://tramitai_app:app-local@postgres:5432/tramitai
DATABASE_OWNER_URL=postgres://tramitai_owner:owner-local@postgres:5432/tramitai
DB_APP_ROLE=tramitai_app

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Segredos de campo (tokens da Meta cifrados no banco) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- WhatsApp (app único do TramitAI na Meta) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# fake = não envia nada para a Meta (dev). cloud_api = envio real.
WHATSAPP_GATEWAY=fake
# Ponte Baileys (serviço bridge). Segredo compartilhado backend <-> ponte, mínimo 32 caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHATSAPP_BRIDGE_URL=http://bridge:3100
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_GRAPH_VERSION=v24.0

# --- IA ---
# fake = respostas determinísticas locais (dev). anthropic = API da Anthropic (requer ANTHROPIC_API_KEY).
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=

# --- Andamentos (DataJud) ---
# fake (dev, nada sai da máquina) ou datajud
PROCESS_SOURCE=fake
DATAJUD_URL=https://api-publica.datajud.cnj.jus.br
# Chave pública da API do DataJud: copie da wiki do CNJ (https://datajud-wiki.cnj.jus.br/api-publica/acesso)
DATAJUD_API_KEY=
CASE_CHECK_INTERVAL_HOURS=2

# --- Publicações do Diário (DJEN, API pública do CNJ, sem chave) ---
# djen (real) ou fake (dev, nada sai da máquina)
PUBLICATION_SOURCE=djen
